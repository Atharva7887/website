# Copy to .env.local and fill in your Sanity project values once you've created
# a project at https://www.sanity.io/manage. Without these, the site renders
# fine using built-in default content; the /studio route shows setup instructions.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# The partnership form (/partner) sends through Resend. Without these, the
# form reports that delivery isn't configured yet rather than a false
# success. CONTACT_FROM_EMAIL must use a domain verified in Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
